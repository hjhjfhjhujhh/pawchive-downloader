# ============================================================
# 运行时产物（会被自动重建，不要提交）
# ============================================================
helper/config.json
helper/host.log
helper/aria2.*.log
helper/python-path.txt
helper/extension-id.txt
helper/host-manifest.*.json.bak
helper/registry-chrome.*.txt
helper/registry-edge.*.txt

# 扩展签名私钥：只在打包签名时用得到，绝不提交
helper/keys/

# Edge 加载扩展时生成的编译规则集（不要删，但打包/提交时排除）
extension/_metadata/

# ============================================================
# aria2：本项目不分发它，二进制一律不入库
# 使用者自行准备：放到 helper\ 下、写进 config.json 的 "aria2c"、或装进 PATH
# ============================================================
aria2c.exe

# ============================================================
# Python / 编辑器 / 系统产物
# ============================================================
__pycache__/
*.pyc
*.tmp
.vs/
Thumbs.db
desktop.ini

# 临时提交信息文件
_unused/commit-msg-*.txt

# ============================================================
# 本地档案 / 测试产物（不入库）
# ============================================================
_unused/
_test/node_modules/
_test/package-lock.json
_test/*.png
